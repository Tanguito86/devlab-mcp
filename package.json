{
  "name": "devlab-mcp-suite",
  "version": "0.0.0",
  "private": true,
  "description": "DevLab MCP Suite — modular testing and automation MCP servers for Android, browsers, and beyond.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "benchmark:ab04:verify": "node scripts/threejs-game-skills-ab04.mjs verify-contract",
    "benchmark:ab04:verify-external": "node scripts/threejs-game-skills-ab04.mjs verify-external",
    "benchmark:ab04:sync-derived": "node scripts/threejs-game-skills-ab04.mjs sync-derived",
    "benchmark:ab04:materialize": "node scripts/threejs-game-skills-ab04.mjs materialize",
    "benchmark:ab04:compare-baselines": "node scripts/threejs-game-skills-ab04.mjs compare-baselines",
    "benchmark:ab04:verify-scaffold": "node scripts/threejs-game-skills-ab04.mjs verify-scaffold",
    "benchmark:ab04:read-guidance": "node scripts/threejs-game-skills-ab04.mjs read-guidance",
    "benchmark:ab04:verify-result": "node scripts/threejs-game-skills-ab04.mjs verify-result",
    "benchmark:ab04:compare-results": "node scripts/threejs-game-skills-ab04.mjs compare-results",
    "benchmark:ab04:smoke-scaffold": "node scripts/threejs-game-skills-ab04-smoke.mjs",
    "asset-forge": "node scripts/asset-forge.mjs",
    "asset-forge:validate": "node scripts/asset-forge.mjs validate-catalog",
    "asset-forge:build:cinder": "node scripts/asset-forge.mjs build cinder-relay-drone --version 1.0.0-pilot.1",
    "asset-forge:batch": "node scripts/asset-forge.mjs build-batch catalog",
    "aseprite:ingest": "node packages/aseprite-ingest/dist/cli.js",
    "gm-bridge:pilot": "corepack pnpm --filter @tanguito/devlab-gm-ide-adapter build && node scripts/gm-hermes-bridge-pilot.mjs",
    "benchmark:galaxy-render": "corepack pnpm --filter @tanguito/browser-dev-mcp benchmark:galaxy-render",
    "contract:ash-relay:v2:verify": "node --test tests/ash-relay-contract-v2.test.mjs",
    "contract:capabilities:verify": "node --test tests/hermes-capability-registry.test.mjs",
    "clean": "pnpm -r clean",
    "doctor": "pnpm -r doctor",
    "pack:dry-run": "pnpm -r pack:dry-run",
    "setup": "node scripts/devlab-setup.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tanguito/devlab-img2threejs-asset-forge": "workspace:*"
  }
}

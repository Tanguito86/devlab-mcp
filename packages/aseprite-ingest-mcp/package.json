{
  "name": "@tanguito/aseprite-ingest-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that ingests Aseprite sources into the DevLab Asset Forge catalog. Confined sources, confined writes, DRAFT only.",
  "type": "module",
  "license": "MIT",
  "author": "Tanguito86",
  "main": "dist/index.js",
  "bin": {
    "aseprite-ingest-mcp": "dist/index.js"
  },
  "files": ["dist", "schemas", "scripts", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "doctor": "node scripts/doctor.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanguito/devlab-aseprite-ingest": "workspace:*",
    "@tanguito/devlab-gm-ide-adapter": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=20" }
}

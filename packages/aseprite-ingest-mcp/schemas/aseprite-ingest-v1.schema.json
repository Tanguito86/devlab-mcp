{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanguito.local/devlab/aseprite-ingest-v1.schema.json",
  "title": "DevLab Aseprite ingest MCP server v1",
  "type": "object",
  "$defs": {
    "tool": { "enum": ["aseprite_status", "aseprite_inspect", "aseprite_ingest"] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Relative to DEVLAB_ASEPRITE_SOURCE_ROOT. Absolute paths are not expressible."
    },
    "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "origin": { "enum": ["top-left", "top-centre", "centre", "bottom-centre"] },
    "statusRequest": { "type": "object", "additionalProperties": false, "properties": {} },
    "inspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": { "source": { "$ref": "#/$defs/sourcePath" } }
    },
    "ingestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assetId", "version"],
      "properties": {
        "source": { "$ref": "#/$defs/sourcePath" },
        "assetId": { "$ref": "#/$defs/assetId" },
        "version": { "$ref": "#/$defs/version" },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "ingestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schemaVersion", "requestId", "serverGate", "assetId", "version", "frameCount", "dimensions", "origin", "specPath", "specSha256", "artifactManifestPath", "exports", "deterministic", "asepriteVersion", "catalogStatus", "catalogEntry"],
      "properties": {
        "ok": { "const": true },
        "schemaVersion": { "const": 1 },
        "requestId": { "type": ["string", "number"] },
        "serverGate": { "const": "CATALOG_WRITE" },
        "assetId": { "$ref": "#/$defs/assetId" },
        "version": { "$ref": "#/$defs/version" },
        "frameCount": { "type": "integer", "minimum": 1 },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
        },
        "specPath": { "type": "string", "minLength": 1 },
        "specSha256": { "$ref": "#/$defs/digest" },
        "artifactManifestPath": { "type": "string", "minLength": 1 },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/digest" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "deterministic": { "const": true },
        "asepriteVersion": { "type": "string" },
        "catalogStatus": { "const": "DRAFT" },
        "catalogEntry": { "type": "object" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanguito.local/devlab/gamemaker-write-v1.schema.json",
  "title": "DevLab GameMaker write-tier MCP server v1",
  "type": "object",
  "$defs": {
    "tool": { "enum": ["gamemaker_apply", "gamemaker_verify_text", "gamemaker_rollback", "gamemaker_create_project"] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transactionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectLoad", "compile", "runtime"],
      "properties": {
        "projectLoad": { "type": "boolean" },
        "compile": { "type": "boolean" },
        "runtime": { "enum": ["required", "optional", "forbidden"] }
      }
    },
    "plannedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "beforeSha256", "afterSha256", "afterContentBase64"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "action": { "enum": ["modify", "create"] },
        "beforeSha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "afterSha256": { "$ref": "#/$defs/digest" },
        "afterContentBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "mutationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "transactionId", "operation", "capability", "gate", "projectRoot",
        "snapshotHash", "projectFingerprint", "expectedHead", "allowlist", "allowedExtensions",
        "files", "verification", "rollback"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "transactionId": { "$ref": "#/$defs/transactionId" },
        "operation": { "const": "apply-safe" },
        "capability": { "const": "GM_APPLY_SAFE_V1" },
        "gate": { "const": "PLAN_ONLY" },
        "projectRoot": { "$ref": "#/$defs/relativePath" },
        "snapshotHash": { "$ref": "#/$defs/digest" },
        "projectFingerprint": { "$ref": "#/$defs/digest" },
        "expectedHead": { "type": ["string", "null"] },
        "allowlist": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/relativePath" } },
        "allowedExtensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["gml", "json", "resource_order", "yy", "yyp"] }
        },
        "files": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/plannedFile" } },
        "verification": { "$ref": "#/$defs/verificationPolicy" },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": { "required": { "const": true } }
        }
      }
    },
    "applyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "plan", "planHash", "confirm"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/relativePath" },
        "plan": { "$ref": "#/$defs/mutationPlan" },
        "planHash": { "$ref": "#/$defs/digest" },
        "confirm": { "const": true },
        "dryRun": { "type": "boolean" }
      }
    },
    "verifyTextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/relativePath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "plan": { "$ref": "#/$defs/mutationPlan" },
        "planHash": { "$ref": "#/$defs/digest" }
      }
    },
    "rollbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "transactionId", "planHash", "expectedProjectFingerprint", "confirm"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/relativePath" },
        "transactionId": { "$ref": "#/$defs/transactionId" },
        "planHash": { "$ref": "#/$defs/digest" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "confirm": { "const": true }
      }
    },
    "createProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "name", "confirm"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/relativePath", "description": "Target must be absent and its real parent directory must already exist" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "confirm": { "const": true },
        "dryRun": { "type": "boolean" }
      }
    }
  }
}

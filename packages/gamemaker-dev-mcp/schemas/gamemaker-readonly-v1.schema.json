{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devlab.local/schemas/gamemaker-readonly-v1.schema.json",
  "title": "GameMaker read-only and plan-only MCP v1 schema catalog",
  "x-tools": [
    { "name": "gamemaker_status", "input": "#/$defs/statusInput", "output": "#/$defs/statusOutput", "description": "Read governed project and process status." },
    { "name": "gamemaker_inspect", "input": "#/$defs/inspectInput", "output": "#/$defs/inspectOutput", "description": "Inspect the canonical project snapshot and fingerprint." },
    { "name": "gamemaker_read_text", "input": "#/$defs/readTextInput", "output": "#/$defs/readTextOutput", "description": "Read bounded UTF-8 project files with byte-exact hashes." },
    { "name": "gamemaker_plan", "input": "#/$defs/planInput", "output": "#/$defs/planOutput", "description": "Produce an applicable immutable text-edit plan without writing." },
    { "name": "gamemaker_plan_new_script", "input": "#/$defs/newScriptInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan creation and registration of a script." },
    { "name": "gamemaker_plan_new_object", "input": "#/$defs/newObjectInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan creation and registration of an object and its events." },
    { "name": "gamemaker_plan_new_room", "input": "#/$defs/newRoomInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan creation and registration of a room." },
    { "name": "gamemaker_plan_place_instance", "input": "#/$defs/placeInstanceInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan placing instances in an existing room." },
    { "name": "gamemaker_plan_new_tileset", "input": "#/$defs/newTilesetInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan a tileset from an existing sprite." },
    { "name": "gamemaker_plan_tile_layer", "input": "#/$defs/tileLayerInput", "output": "#/$defs/authoredPlanOutput", "description": "Plan a tile layer in an existing room." }
  ],
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Project directory relative to DEVLAB_GM_PROJECTS_DIR"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schemaVersion", "requestId", "error"],
      "properties": {
        "ok": { "const": false },
        "schemaVersion": { "const": 1 },
        "requestId": { "type": ["string", "number"] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "recoverable"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "recoverable": { "type": "boolean" }
          }
        }
      }
    },
    "statusInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath"],
      "properties": { "projectPath": { "$ref": "#/$defs/projectPath" } }
    },
    "inspectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath"],
      "properties": { "projectPath": { "$ref": "#/$defs/projectPath" } }
    },
    "planInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "allowlist", "changes"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "allowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "content": { "type": "string", "maxLength": 1048576, "description": "At most 1048576 UTF-8 bytes per file and 4194304 UTF-8 bytes across all changes." }
            }
          }
        }
      }
    },
    "readTextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "paths"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "newScriptInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "name", "gml"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gml": { "type": "string", "minLength": 1, "maxLength": 262144 }
      }
    },
    "eventSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "gml"],
      "properties": {
        "event": { "enum": ["create", "destroy", "alarm", "step", "draw", "other", "cleanup"] },
        "eventNum": { "type": "integer", "minimum": 0, "maximum": 255 },
        "gml": { "type": "string", "minLength": 1, "maxLength": 262144 }
      }
    },
    "roomInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectName", "x", "y"],
      "properties": {
        "objectName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "instanceName": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "newObjectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "name", "events"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "events": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/eventSpec" } },
        "spriteName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "persistent": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "solid": { "type": "boolean" }
      }
    },
    "newRoomInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "name"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "instances": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/roomInstance" } },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "persistent": { "type": "boolean" }
      }
    },
    "placeInstanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "roomName", "instances"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "roomName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "instances": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/roomInstance" } }
      }
    },
    "newTilesetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "name", "spriteName", "tileWidth", "tileHeight"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "spriteName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tileWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "tileHeight": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "tileLayerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "expectedProjectFingerprint", "roomName", "layerName", "tilesetName", "width", "height", "cells"],
      "properties": {
        "projectPath": { "$ref": "#/$defs/projectPath" },
        "expectedProjectFingerprint": { "$ref": "#/$defs/digest" },
        "roomName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "layerName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tilesetName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "cells": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer" } },
        "depth": { "type": "integer", "minimum": -16000, "maximum": 16000 }
      }
    },
    "statusOutput": {
      "description": "Structured status success or the common typed error",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "capability", "serverGate", "projectFingerprint", "processes"],
          "properties": {
            "ok": { "const": true },
            "capability": { "const": "GM_STATUS_V1" },
            "serverGate": { "const": "READ_ONLY" },
            "projectFingerprint": { "$ref": "#/$defs/digest" },
            "processes": { "type": "object" }
          }
        },
        { "$ref": "#/$defs/error" }
      ]
    },
    "inspectOutput": {
      "description": "Canonical snapshot success or the common typed error",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "capability", "serverGate", "files", "fingerprint", "snapshotHash"],
          "properties": {
            "ok": { "const": true },
            "capability": { "const": "GM_INSPECT_V1" },
            "serverGate": { "const": "READ_ONLY" },
            "files": { "type": "array" },
            "fingerprint": { "$ref": "#/$defs/digest" },
            "snapshotHash": { "$ref": "#/$defs/digest" }
          }
        },
        { "$ref": "#/$defs/error" }
      ]
    },
    "readTextOutput": {
      "description": "Bounded byte-exact UTF-8 file contents or the common typed error",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "capability", "serverGate", "projectFingerprint", "files", "totalBytes"],
          "properties": {
            "ok": { "const": true },
            "capability": { "const": "GM_INSPECT_V1" },
            "serverGate": { "const": "READ_ONLY" },
            "projectFingerprint": { "$ref": "#/$defs/digest" },
            "files": { "type": "array" },
            "totalBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
          }
        },
        { "$ref": "#/$defs/error" }
      ]
    },
    "planOutput": {
      "description": "Applicable immutable plan plus a content-free summary, or the common typed error",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "capability", "serverGate", "immutable", "changes", "planHash", "plan"],
          "properties": {
            "ok": { "const": true },
            "capability": { "const": "GM_PLAN_V1" },
            "serverGate": { "const": "PLAN_ONLY" },
            "immutable": { "const": true },
            "changes": { "type": "array" },
            "planHash": { "$ref": "#/$defs/digest" },
            "plan": { "type": "object", "description": "Complete GM_APPLY_SAFE_V1 plan for write-tier revalidation" }
          }
        },
        { "$ref": "#/$defs/error" }
      ]
    },
    "authoredPlanOutput": {
      "description": "Applicable immutable resource-authoring plan or the common typed error",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "capability", "serverGate", "immutable", "resourceKind", "resourceName", "resourcePath", "changes", "planHash", "plan"],
          "properties": {
            "ok": { "const": true },
            "capability": { "const": "GM_PLAN_V1" },
            "serverGate": { "const": "PLAN_ONLY" },
            "immutable": { "const": true },
            "resourceKind": { "enum": ["script", "object", "room", "instance", "tileset", "tileLayer"] },
            "resourceName": { "type": "string" },
            "resourcePath": { "type": "string" },
            "changes": { "type": "array" },
            "planHash": { "$ref": "#/$defs/digest" },
            "plan": { "type": "object", "description": "Complete GM_APPLY_SAFE_V1 plan for write-tier revalidation" }
          }
        },
        { "$ref": "#/$defs/error" }
      ]
    }
  }
}

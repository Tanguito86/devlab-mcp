{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanguito.local/devlab/gm-adapter-v1.schema.json",
  "title": "DevLab governed GameMaker adapter v1",
  "type": "object",
  "$defs": {
    "capability": { "enum": ["GM_STATUS_V1", "GM_INSPECT_V1", "GM_PLAN_V1", "GM_APPLY_SAFE_V1", "GM_VERIFY_V1", "GM_ROLLBACK_V1"] },
    "verificationPolicy": { "type": "object", "additionalProperties": false, "required": ["projectLoad", "compile", "runtime"], "properties": { "projectLoad": { "type": "boolean" }, "compile": { "type": "boolean" }, "runtime": { "enum": ["required", "optional", "forbidden"] } } },
    "requestBase": { "type": "object", "additionalProperties": true, "required": ["projectRoot", "expectedProjectFingerprint", "expectedHead", "allowlist", "capability", "transactionId", "timeoutMs", "verificationPolicy", "evidenceRoot"], "properties": { "projectRoot": { "type": "string", "minLength": 1 }, "expectedProjectFingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "expectedHead": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" }, "allowlist": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "capability": { "$ref": "#/$defs/capability" }, "transactionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }, "verificationPolicy": { "$ref": "#/$defs/verificationPolicy" }, "evidenceRoot": { "type": "string", "minLength": 1 } } },
    "statusRequest": { "$ref": "#/$defs/requestBase" },
    "inspectRequest": { "$ref": "#/$defs/requestBase" },
    "planRequest": { "allOf": [{ "$ref": "#/$defs/requestBase" }, { "type": "object", "required": ["files"], "properties": { "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "action"], "properties": { "path": { "type": "string" }, "action": { "enum": ["modify", "create"] }, "content": { "type": "string" }, "contentBase64": { "type": "string" } } } }, "allowedExtensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }] },
    "applySafeRequest": { "allOf": [{ "$ref": "#/$defs/requestBase" }, { "type": "object", "required": ["plan", "planHash", "confirm"] }] },
    "verifyRequest": { "allOf": [{ "$ref": "#/$defs/requestBase" }, { "type": "object", "required": ["levels"] }] },
    "rollbackRequest": { "allOf": [{ "$ref": "#/$defs/requestBase" }, { "type": "object", "required": ["planHash", "confirm"] }] }
  }
}

{
  "name": "@tanguito/devlab-asset-gm-bridge",
  "version": "0.1.0",
  "description": "Governed composition bridge between the DevLab Asset Forge catalog and the GameMaker IDE adapter (ASSET_GM_BRIDGE_V1).",
  "type": "module",
  "license": "MIT",
  "author": "Tanguito86",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "schemas", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@tanguito/devlab-gm-ide-adapter": "workspace:*",
    "@tanguito/devlab-img2threejs-asset-forge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=20" }
}

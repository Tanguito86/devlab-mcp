{
  "name": "@tanguito/devlab-topdown-shooter-kit",
  "version": "0.1.0",
  "description": "Deterministic, renderer-agnostic mechanisms for reusable top-down shooters.",
  "type": "module",
  "license": "MIT",
  "author": "Tanguito86",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "schemas", "examples", "fixtures", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=20" }
}

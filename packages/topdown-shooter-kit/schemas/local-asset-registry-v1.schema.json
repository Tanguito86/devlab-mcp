{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devlab:local-asset-registry:v1",
  "title": "DevLab Local Asset Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "runtimePath", "sha256", "mediaType", "byteSize", "source", "runtime"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "runtimePath": { "type": "string", "minLength": 1, "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?!.*//)(?!.*\\/$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[%?#])(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 },
          "byteSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "enum": ["generated", "authored", "licensed", "derived"] },
              "reference": { "type": "string", "minLength": 1, "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F])(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:).+$" }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preload", "required"],
            "properties": {
              "preload": { "type": "boolean" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}

{
  "schemaVersion": 1,
  "id": "aseprite-ingest-mcp",
  "version": "0.1.0",
  "package": "@tanguito/aseprite-ingest-mcp",
  "transport": "STDIO",
  "publicTools": ["aseprite_status", "aseprite_inspect", "aseprite_ingest"],
  "internalCapabilities": ["ASEPRITE_INGEST_V1"],
  "mode": "CATALOG_INGEST_EXTERNAL_PROCESS",
  "projectMutation": false,
  "catalogMutation": true,
  "resources": 0,
  "prompts": 0,
  "inputSchema": "packages/aseprite-ingest-mcp/schemas/aseprite-ingest-v1.schema.json",
  "configuration": "DEVLAB_ASEPRITE absolute executable; DEVLAB_ASEPRITE_SOURCE_ROOT confines every source; DEVLAB_ASEPRITE_REPO_ROOT confines every write; DEVLAB_ASEPRITE_WRITE explicit opt-in for ingest",
  "dependencies": ["@tanguito/devlab-aseprite-ingest", "@tanguito/devlab-gm-ide-adapter"],
  "runtimeStatus": "LOCAL_ASEPRITE_VERIFIED",
  "productionVerified": false,
  "externalProcess": "ASEPRITE_HEADLESS",
  "toolchainSource": "ENVIRONMENT_ONLY",
  "sourcePaths": "RELATIVE_TO_SOURCE_ROOT_ONLY",
  "callerSuppliedFlags": false,
  "emittedLifecycleStatus": "DRAFT",
  "determinismGate": "EARNED_BY_DOUBLE_EXPORT",
  "compilerExecution": false,
  "runtimeExecution": false,
  "networkAccess": false,
  "prohibitedOperations": [
    "absolute or traversing source paths",
    "executable selection through tool arguments",
    "raw Aseprite flags through tool arguments",
    "Aseprite --script execution",
    "writing outside the configured catalog root",
    "approving its own catalog entry",
    "GameMaker project mutation",
    "network"
  ]
}

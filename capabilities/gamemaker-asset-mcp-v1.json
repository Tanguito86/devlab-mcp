{
  "schemaVersion": 1,
  "id": "gamemaker-asset-mcp",
  "version": "0.1.0",
  "package": "@tanguito/gamemaker-asset-mcp",
  "transport": "STDIO",
  "publicTools": ["asset_status", "asset_inspect", "asset_plan_import", "asset_apply_import", "asset_rollback_import"],
  "internalCapabilities": ["ASSET_GM_BRIDGE_V1"],
  "mode": "ASSET_IMPORT_NO_PROCESS_EXECUTION",
  "writeTools": 2,
  "projectMutation": true,
  "resources": 0,
  "prompts": 0,
  "inputSchema": "packages/gamemaker-asset-mcp/schemas/gamemaker-asset-v1.schema.json",
  "configuration": "DEVLAB_GM_PROJECTS_DIR, DEVLAB_GM_ASSET_CATALOG, DEVLAB_GM_ASSET_REPO_ROOT; DEVLAB_GM_ASSET_WRITE explicit opt-in for apply and rollback; optional DEVLAB_GM_EVIDENCE_ROOT",
  "dependencies": ["@tanguito/devlab-asset-gm-bridge", "@tanguito/devlab-gm-ide-adapter"],
  "runtimeStatus": "LOCAL_VERIFIED",
  "productionVerified": false,
  "compilerExecution": false,
  "runtimeExecution": false,
  "instrumentation": "NONE_PINNED",
  "planTransport": "BY_REFERENCE_VIA_EVIDENCE",
  "lifecycleGate": "APPROVED_ONLY",
  "networkAccess": false,
  "prohibitedOperations": [
    "compile",
    "run",
    "Igor or Runner execution",
    "pilot instrumentation through tool arguments",
    "importing a non-APPROVED asset",
    "writing without the explicit host opt-in",
    "network"
  ]
}

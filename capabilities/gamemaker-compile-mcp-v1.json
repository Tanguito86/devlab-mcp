{
  "schemaVersion": 1,
  "id": "gamemaker-compile-mcp",
  "version": "0.1.0",
  "package": "@tanguito/gamemaker-compile-mcp",
  "transport": "STDIO",
  "publicTools": ["gamemaker_toolchain_status", "gamemaker_verify_build"],
  "internalCapabilities": ["GM_VERIFY_V1"],
  "mode": "BUILD_VERIFICATION_PROCESS_OWNING",
  "writeTools": 0,
  "projectMutation": false,
  "resources": 0,
  "prompts": 0,
  "inputSchema": "packages/gamemaker-compile-mcp/schemas/gamemaker-compile-v1.schema.json",
  "configuration": "DEVLAB_GM_PROJECTS_DIR, DEVLAB_GM_ALLOW_IGOR explicit opt-in, DEVLAB_GM_IGOR, DEVLAB_GM_RUNTIME, DEVLAB_GM_PROJECT_TOOL, DEVLAB_GM_USER_DIR; optional DEVLAB_GM_EVIDENCE_ROOT and DEVLAB_GM_TIMEOUT_MS",
  "dependencies": ["@tanguito/devlab-gm-ide-adapter"],
  "runtimeStatus": "LOCAL_IGOR_VERIFIED",
  "productionVerified": false,
  "platform": "WINDOWS_ONLY",
  "compilerExecution": true,
  "runtimeExecution": true,
  "toolchainSource": "ENVIRONMENT_ONLY",
  "verificationLevels": ["TEXT_VALID", "PROJECT_LOAD_VALID", "COMPILE_VALID", "RUNTIME_VALID"],
  "igorVerb": "Run",
  "compileOnlyAvailable": false,
  "compileOnlyBlockedBy": "Package does not invoke the asset compiler; PackageZip does but is licence-gated (Permission Error 0000002A)",
  "diagnostics": "PARSED_AND_PATH_SCRUBBED",
  "assetBridgeAvailable": false,
  "networkAccess": false,
  "prohibitedOperations": [
    "project mutation",
    "apply",
    "rollback",
    "import",
    "toolchain configuration through tool arguments",
    "verification level selection through tool arguments",
    "timeout override through tool arguments",
    "terminating a process this server did not start",
    "Asset Forge",
    "Asset-GM Bridge",
    "network"
  ]
}
